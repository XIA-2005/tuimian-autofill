{
  "name": "tuimian-autofill",
  "version": "2.0.6",
  "private": true,
  "description": "预推免报名系统辅助填写浏览器扩展（Edge/Chrome，Manifest V3）",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node build.mjs && node test/run.js",
    "test:e2e": "node build.mjs && node test/playwright.mjs",
    "test:regression": "node build.mjs && node test/regression/run.js",
    "test:regression:e2e": "node build.mjs && node test/regression/run-e2e.js && node test/dependency-e2e.mjs && node test/driver-cancellation-e2e.mjs && node test/deadline-stop-e2e.mjs && node test/manual-handoff-e2e.mjs && node test/manual-handoff-e2e.mjs --reject-resume",
    "test:deadline:e2e": "node build.mjs && node test/deadline-stop-e2e.mjs",
    "test:handoff:e2e": "node build.mjs && node test/manual-handoff-e2e.mjs",
    "test:drivers:e2e": "node test/driver-cancellation-e2e.mjs",
    "test:dependency:e2e": "node build.mjs && node test/dependency-e2e.mjs",
    "check:adapters": "node build.mjs && node test/check-adapters.js",
    "bench": "node test/bench/run.mjs --self-test",
    "bench:oracle": "node test/bench/run.mjs --oracle docs/analysis/v10-review-2026-09-11/oracle-F01.signed.json",
    "test:e2e:real": "node test/bundle-real-e2e.mjs && node test/real-e2e.cjs",
    "typecheck": "tsc --noEmit",
    "package": "npm test && node package.mjs",
    "test:offline": "npm run typecheck && npm test && npm run check:adapters && npm run test:regression && npm run bench"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "@types/node": "latest",
    "esbuild": "latest",
    "jsdom": "latest",
    "playwright": "^1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "latest",
    "vue": "3.5.13"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0"
  }
}
