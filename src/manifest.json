{
  "manifest_version": 3,
  "name": "预推免填表助手",
  "version": "2.0.0",
  "author": "tuimian-autofill",
  "minimum_chrome_version": "111",
  "description": "辅助填写高校预推免/夏令营报名系统：本地档案、一键填充、漏填高亮、验证码 OCR（可选）。数据不出本机。",
  "permissions": [
    "storage",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "http://localhost:18765/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "预推免填表助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "options/captcha-settings.html",
        "vendor/tesseract.min.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["tesseract-loader.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["world/main-world.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
